# kube-apiserver --audit-webhook-config-file
apiVersion: v1
kind: Config
clusters:
  - name: sentinelforge
    cluster:
      server: https://sentinelforge.example.internal/api/v1/ingest/kubernetes?host=prod-cluster
      # certificate-authority: /etc/kubernetes/audit/sentinelforge-ca.pem
contexts:
  - name: sentinelforge
    context:
      cluster: sentinelforge
      user: sentinelforge
current-context: sentinelforge
users:
  - name: sentinelforge
    user:
      token: REPLACE_WITH_SENTINELFORGE_API_KEY
