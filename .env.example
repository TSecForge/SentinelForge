# Copy to .env and adjust. Never commit a real .env.

# --- core ---
DATABASE_URL=sqlite:///./sentinelforge.db
# DATABASE_URL=postgresql+psycopg://sentinelforge:password@localhost:5432/sentinelforge
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# If set, every /api/v1 endpoint except /health and /about requires header X-API-Key.
API_KEY=
RATE_LIMIT_PER_MINUTE=1200
MAX_BATCH_EVENTS=20000
STORE_UNMATCHED_EVENTS=true

# --- rules & plugins ---
RULE_PATHS=builtin,../custom-rules
AUTO_ACTIVATE_RULES=true
PLUGIN_PATHS=
PLUGINS=

# --- discovery ---
# Allows the API to run collectors/windows/discovery.ps1 (locally or over WinRM). Off by default.
ENABLE_LIVE_DISCOVERY=false
DISCOVERY_TIMEOUT_SECONDS=180

# --- SIEM: disabled | webhook | splunk | elastic (or a plugin adapter name) ---
SIEM_MODE=disabled
SIEM_TIMEOUT_SECONDS=5

# Generic webhook. For a local demo use the built-in receiver:
# WEBHOOK_URL=http://127.0.0.1:8000/api/v1/siem/events
WEBHOOK_URL=
WEBHOOK_AUTH_HEADER=

# Splunk HTTP Event Collector
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=
SPLUNK_SOURCE=sentinelforge
SPLUNK_VERIFY_TLS=true

# Elasticsearch / OpenSearch
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=sentinelforge-detections
ELASTIC_VERIFY_TLS=true

# --- branding (upstream attribution is kept separately on the About page) ---
PROJECT_NAME=SentinelForge
PROJECT_DESCRIPTION=Agentless Environment-Aware Detection Engineering Platform
ORGANIZATION_NAME=
ORGANIZATION_LOGO=
PRIMARY_BRAND_COLOR=#38bdf8
DASHBOARD_TITLE=Detection Operations
FOOTER_TEXT=

# --- frontend (Vite; values are visible to anyone who loads the UI) ---
# VITE_API_URL=
# VITE_API_KEY=
